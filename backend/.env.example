# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zingiznikiga almashtiring.
# .env faylini HECH QACHON GitHub'ga yuklamang (u .gitignore ichida).

# Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:PAROL@db.XXXX.supabase.co:5432/postgres"

# Token imzolash uchun uzun tasodifiy satr (kamida 32 belgi)
JWT_SECRET="bu-yerga-uzun-tasodifiy-satr-yozing"

# Frontend qaysi manzildan ochiladi (CORS uchun)
FRONTEND_URL="http://localhost:5500"

PORT=3000
